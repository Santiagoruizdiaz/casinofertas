# Casinofertas en Hostinger (Apache/LiteSpeed). Netlify ignora este archivo.
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On
# Forzar HTTPS y sacar el www, para que Google vea una sola versión de cada página
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# Agregar la barra final (/pba -> /pba/), igual que en Netlify
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME}/ -d
RewriteRule ^(.*)$ /$1/ [L,R=301]

<IfModule mod_headers.c>
  # El panel no se indexa
  <If "%{REQUEST_URI} =~ m#^/admin/#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
  # Los archivos de _astro llevan hash en el nombre: se pueden cachear un año
  <FilesMatch "\.(css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|ico|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml text/plain image/svg+xml application/manifest+json
</IfModule>
