---
import Base from "../../layouts/Base.astro";
import PromoCard from "../../components/PromoCard.astro";
import { TIPOS, VERTICALES, cargarPromos, casinos, provincias, type Provincia } from "../../lib/datos";

export function getStaticPaths() {
  return provincias.map((provincia) => ({ params: { provincia: provincia.id }, props: { provincia } }));
}

const { provincia } = Astro.props as { provincia: Provincia };
const promos = (await cargarPromos())
  .filter((p) => p.provincia.id === provincia.id)
  .sort((a, b) => (a.hasta || "9999").localeCompare(b.hasta || "9999"));
const tipos = Object.entries(TIPOS).filter(([k]) => promos.some((p) => p.tipo === k));
// El filtro casino / deportes solo aparece si cambia algo: tiene que haber ofertas de los dos lados.
const hayVerticales = promos.some((p) => p.vertical !== "deportes") && promos.some((p) => p.vertical !== "casino")
  && promos.some((p) => p.vertical !== "ambos");
const habilitados = casinos.filter((c) => c.licencias[provincia.id]).length;
---
<Base
  title={`Promos de casinos online legales en ${provincia.nombre} | Casinofertas`}
  description={`Promociones vigentes de los ${habilitados} casinos online con licencia en ${provincia.nombre}.`}
>
  <section class="page-head">
    <p class="eyebrow">Promos de casinos legales</p>
    <h1>{provincia.nombre}</h1>
    <div class="meta">
      <label>
        <span class="sr">Cambiar de provincia: </span>
        <select id="prov" aria-label="Cambiar de provincia">
          {provincias.map((p) => <option value={p.id} selected={p.id === provincia.id}>{p.nombre}</option>)}
        </select>
      </label>
      {habilitados > 0 && provincia.regulador && (
        <span>
          Licencias de <a href={provincia.fuente} rel="noopener" target="_blank">{provincia.regulador}</a>
        </span>
      )}
    </div>
    {promos.length > 0 && (
      <div class="stats">
        <div class="stat"><b id="n-promos">{promos.length}</b><span>promos vigentes</span></div>
        <div class="stat"><b>{habilitados}</b><span>casinos con licencia</span></div>
        <div class="stat warn" id="stat-pronto" hidden><b id="n-pronto">0</b><span>vencen esta semana</span></div>
      </div>
    )}
  </section>

  {promos.length > 0 ? (
    <>
      <div class="filters">
        {hayVerticales && (
          <div class="types verticales" role="group" aria-label="Casino o deportes">
            <button class="pill" data-vertical="todas" aria-pressed="true">Todo</button>
            <button class="pill" data-vertical="casino" aria-pressed="false">{VERTICALES.casino}</button>
            <button class="pill" data-vertical="deportes" aria-pressed="false">{VERTICALES.deportes}</button>
          </div>
        )}
        <div class="types" role="group" aria-label="Filtrar por tipo">
          <button class="pill" data-tipo="todas" aria-pressed="true">Todas</button>
          {tipos.map(([k, v]) => <button class="pill" data-tipo={k} aria-pressed="false">{v}</button>)}
        </div>
        <div class="tools">
          <input id="q" type="search" placeholder="Buscar casino o promo" aria-label="Buscar" />
          <select id="orden" aria-label="Ordenar">
            <option value="vence">Vencen primero</option>
            <option value="nuevas">Más nuevas</option>
            <option value="casino">Por casino</option>
          </select>
        </div>
      </div>
      <p class="count" id="count">{promos.length} {promos.length === 1 ? "promo" : "promos"}</p>
      <div class="grid" id="grid">
        {promos.map((p) => <PromoCard promo={p} />)}
      </div>
      <div class="empty" id="vacio" hidden>No hay promos con este filtro.</div>
    </>
  ) : (
    <div class="empty">
      {provincia.estado === "sin-regulacion"
        ? `${provincia.nombre} todavía no regula el juego online, así que no hay casinos online legales para jugar desde acá.`
        : provincia.estado === "en-proceso"
          ? `${provincia.nombre} aprobó el juego online pero todavía no habilitó casinos.`
          : habilitados === 0
            ? `Estamos verificando qué casinos tienen licencia en ${provincia.nombre}.`
            : `Todavía no cargamos promos para ${provincia.nombre}.`}
    </div>
  )}

  <script is:inline define:vars={{ provId: provincia.id }}>
    try { localStorage.setItem("prov", provId); } catch {}
  </script>
  <script>
    const sel = document.querySelector<HTMLSelectElement>("#prov")!;
    sel.addEventListener("change", () => { location.href = `/${sel.value}/`; });

    const grid = document.querySelector<HTMLElement>("#grid");
    if (grid) {
      const cards = [...grid.querySelectorAll<HTMLElement>(".card")];
      const hoy = new Date(); hoy.setHours(0, 0, 0, 0);
      const dias = (d: string) => Math.round((new Date(`${d}T00:00:00`).getTime() - hoy.getTime()) / 864e5);

      // El sitio se reconstruye una vez por día; entre builds, ocultamos lo que venció y avisamos lo que está por vencer.
      let pronto = 0;
      for (const c of cards) {
        const d = dias(c.dataset.hasta!);
        if (d < 0) c.remove();
        if (d >= 0 && d <= 7) pronto++;
        const f = c.querySelector<HTMLElement>(".vence");
        if (f && d >= 0 && d <= 7) {
          f.classList.add("soon");
          f.textContent = d === 0 ? "Vence hoy" : d === 1 ? "Vence mañana" : `Vence en ${d} días`;
        }
      }
      const vivas = cards.filter((c) => c.isConnected);
      document.querySelector("#n-promos")!.textContent = String(vivas.length);
      if (pronto > 0) {
        document.querySelector("#n-pronto")!.textContent = String(pronto);
        document.querySelector<HTMLElement>("#stat-pronto")!.hidden = false;
      }
      const estado = { tipo: "todas", vertical: "todas", q: "", orden: "vence" };
      const count = document.querySelector("#count")!;
      const vacio = document.querySelector<HTMLElement>("#vacio")!;

      const pintar = () => {
        const orden: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
          vence: (a, b) => a.dataset.hasta!.localeCompare(b.dataset.hasta!),
          nuevas: (a, b) => b.dataset.desde!.localeCompare(a.dataset.desde!),
          casino: (a, b) => a.dataset.casino!.localeCompare(b.dataset.casino!),
        };
        let n = 0;
        for (const c of [...vivas].sort(orden[estado.orden])) {
          // Las ofertas "ambos" aparecen tanto en Casino como en Deportes.
          const v = c.dataset.vertical;
          const ok =
            (estado.tipo === "todas" || c.dataset.tipo === estado.tipo) &&
            (estado.vertical === "todas" || v === estado.vertical || v === "ambos") &&
            c.dataset.buscar!.includes(estado.q);
          c.hidden = !ok;
          if (ok) n++;
          grid.append(c);
        }
        count.textContent = `${n} ${n === 1 ? "promo" : "promos"}`;
        vacio.hidden = n > 0;
      };

      for (const campo of ["tipo", "vertical"] as const) {
        const botones = document.querySelectorAll<HTMLButtonElement>(`[data-${campo}].pill`);
        botones.forEach((b) =>
          b.addEventListener("click", () => {
            estado[campo] = b.dataset[campo]!;
            botones.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
            pintar();
          }),
        );
      }
      document.querySelector<HTMLInputElement>("#q")!.addEventListener("input", (e) => {
        estado.q = (e.target as HTMLInputElement).value.trim().toLowerCase();
        pintar();
      });
      document.querySelector<HTMLSelectElement>("#orden")!.addEventListener("change", (e) => {
        estado.orden = (e.target as HTMLSelectElement).value;
        pintar();
      });
      pintar();
    }
  </script>
</Base>
