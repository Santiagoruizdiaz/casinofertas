---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import Marca from "../components/Marca.astro";

interface Props {
  title: string;
  description: string;
  seccion?: "promos" | "casinos" | "juego";
}
const { title, description, seccion = "promos" } = Astro.props;
const actual = (s: string) => (s === seccion ? "page" : undefined);
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f6f6f2" />
    <script is:inline>
      // Aplica el tema elegido antes de pintar, para que no parpadee.
      (() => {
        let tema = null;
        try { tema = localStorage.getItem("tema"); } catch {}
        if (tema !== "light" && tema !== "dark") tema = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = tema;
        document.querySelector('meta[name="theme-color"]').content = tema === "dark" ? "#0a1114" : "#f6f6f2";
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600&family=Figtree:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <Logo />
        <div class="bar-end">
          <nav class="nav" aria-label="Secciones">
            <a href="/" aria-current={actual("promos")}>Promos</a>
            <a href="/casinos/" aria-current={actual("casinos")}>Casinos</a>
            <a href="/juego-responsable/" aria-current={actual("juego")}>Juego responsable</a>
          </nav>
          <button class="tema" type="button" id="tema" aria-label="Activar modo oscuro" title="Cambiar tema">
            <svg class="luna" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
            <svg class="sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>
          </button>
        </div>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="pie">
      <div class="wrap pie-in">
        <span class="age" aria-label="Solo mayores de 18">+18</span>
        <div>
          <p>
            Casinofertas solo lista casinos online con licencia provincial, que operan con dominio .bet.ar. Cada casino
            es legal únicamente en las provincias que lo habilitaron. Jugar compulsivamente es perjudicial para la salud.
          </p>
          <div class="pie-links">
            <a href="/casinos/">Casinos con licencia</a>
            <a href="/juego-responsable/">Dónde pedir ayuda</a>
          </div>
        </div>
      </div>
      <div class="wrap pie-marca"><Marca size={20} /><span>Casinofertas · Argentina</span></div>
    </footer>
    <script>
      const boton = document.querySelector<HTMLButtonElement>("#tema")!;
      const raiz = document.documentElement;
      const pintar = () => {
        const oscuro = raiz.dataset.theme === "dark";
        boton.setAttribute("aria-label", oscuro ? "Activar modo claro" : "Activar modo oscuro");
        boton.setAttribute("aria-pressed", String(oscuro));
      };
      boton.addEventListener("click", () => {
        const tema = raiz.dataset.theme === "dark" ? "light" : "dark";
        raiz.dataset.theme = tema;
        document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content = tema === "dark" ? "#0a1114" : "#f6f6f2";
        try { localStorage.setItem("tema", tema); } catch {}
        pintar();
      });
      pintar();
    </script>
  </body>
</html>
