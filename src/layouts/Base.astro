---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import Marca from "../components/Marca.astro";

interface Props {
  title: string;
  description: string;
  seccion?: "promos" | "casinos" | "juego";
}
const { title, description, seccion = "promos" } = Astro.props;
const actual = (s: string) => (s === seccion ? "page" : undefined);
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f6f6f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1316" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600&family=Figtree:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <Logo />
        <nav class="nav" aria-label="Secciones">
          <a href="/" aria-current={actual("promos")}>Promos</a>
          <a href="/casinos/" aria-current={actual("casinos")}>Casinos</a>
          <a href="/juego-responsable/" aria-current={actual("juego")}>Juego responsable</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="pie">
      <div class="wrap pie-in">
        <span class="age" aria-label="Solo mayores de 18">+18</span>
        <div>
          <p>
            Casinofertas solo lista casinos online con licencia provincial, que operan con dominio .bet.ar. Cada casino
            es legal únicamente en las provincias que lo habilitaron. Jugar compulsivamente es perjudicial para la salud.
          </p>
          <div class="pie-links">
            <a href="/casinos/">Casinos con licencia</a>
            <a href="/juego-responsable/">Dónde pedir ayuda</a>
          </div>
        </div>
      </div>
      <div class="wrap pie-marca"><Marca size={20} /><span>Casinofertas · Argentina</span></div>
    </footer>
  </body>
</html>
